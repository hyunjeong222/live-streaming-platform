# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# docker-compose와 Spring이 같은 파일을 읽는다. Spring은 이 파일을 properties 형식으로 읽으므로
# 값에 따옴표를 붙이지 않고, `$`와 백슬래시(`\`)를 쓰지 않는다(두 쪽이 다른 값으로 읽는다).

# 로컬 MySQL (계정과 DB는 컨테이너 첫 실행 때 자동 생성된다)
MYSQL_PORT=3306
MYSQL_DATABASE=livestream
MYSQL_USER=livestream
# 두 비밀번호는 꼭 채운다. 비어 있으면 MySQL 컨테이너가 시작하지 않는다.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 타임존 (MySQL 컨테이너, JDBC, Hibernate, Jackson 공통)
APP_TIME_ZONE=Asia/Seoul
